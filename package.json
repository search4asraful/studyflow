{
  "name": "studyflow-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:server": "npm run dev --workspace=@studyflow/server",
    "dev:web": "npm run dev --workspace=@studyflow/web",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspace=@studyflow/server",
    "db:push": "npm run db:push --workspace=@studyflow/server",
    "db:seed": "npm run db:seed --workspace=@studyflow/server",
    "db:studio": "npm run db:studio --workspace=@studyflow/server"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
