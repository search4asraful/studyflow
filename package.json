{
  "name": "studyflow-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:server": "npm run dev --workspace=@studyflow/server",
    "dev:web": "npm run dev --workspace=@studyflow/web",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspace=@studyflow/server",
    "db:push": "npx prisma db push --schema=apps/server/prisma/schema.prisma",
    "db:seed": "npx tsx apps/server/prisma/seed.ts",
    "db:studio": "npx prisma studio --schema=apps/server/prisma/schema.prisma"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
