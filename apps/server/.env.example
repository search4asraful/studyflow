# Server Port & Environment
PORT=4000
NODE_ENV="production"

# Supabase PostgreSQL Connection Strings
# Transaction Pooler (port 6543) for runtime queries:
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct / Session Connection (port 5432) for migrations & schema push:
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Security Secrets (use strong random strings)
JWT_SECRET="replace_with_a_secure_random_jwt_secret_production"
JWT_EXPIRES_IN="7d"
COOKIE_SECRET="replace_with_a_secure_random_cookie_secret_production"

# Frontend URL for CORS (your Vercel live domain)
FRONTEND_URL="https://your-app.vercel.app"
