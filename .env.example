# Database Connections (Supabase or Local PostgreSQL)
# For Supabase:
# DATABASE_URL: Transaction Pooler (port 6543) with pgbouncer=true for runtime queries
# DIRECT_URL: Direct / Session connection (port 5432) for migrations & schema push
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# For Local Development (e.g. docker-compose):
# DATABASE_URL="postgresql://asraful:UserPass%23504@127.0.0.1:5432/studyflow?schema=public"
# DIRECT_URL="postgresql://asraful:UserPass%23504@127.0.0.1:5432/studyflow?schema=public"

# Backend Auth & Security Secrets
JWT_SECRET="studyflow_super_secret_jwt_key_production_2026"
JWT_EXPIRES_IN="7d"
COOKIE_SECRET="studyflow_cookie_secret_key_production_2026"
PORT=4000
NODE_ENV="development"

# Cross-Origin URLs (Backend CORS & Frontend API calls)
FRONTEND_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:4000/api"
NEXT_PUBLIC_SOCKET_URL="http://localhost:4000"
